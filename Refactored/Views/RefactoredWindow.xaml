<Window x:Class="DataMaker.Refactored.Views.RefactoredWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DataMaker · 重构版" 
        Width="1280" Height="780" 
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" 
        Closing="Window_Closing"
        Background="#F4F5F7"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 全局现代化控件样式定义 -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#0066CC"/>
        <SolidColorBrush x:Key="PrimaryHoverColor" Color="#0052A3"/>
        <SolidColorBrush x:Key="BorderColor" Color="#DCDFE6"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor" Color="#2C3E50"/>

        <!-- 默认文字与卡片容器 -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- 卡片边框通用样式 -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- 统一按钮样式 -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#F2F3F5"/>
            <Setter Property="BorderBrush" Value="#DCDFE6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#303133"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E4E7ED"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 主操作强调按钮样式 -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHoverColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 统一输入框样式 -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#FFFFFF" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl 样式微调 -->
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <!-- 顶部工具栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 核心三栏主体 -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. 顶部现代化操作与参数栏 -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：题目名与模板快捷键 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="题目名称：" FontWeight="Bold"/>
                    <TextBox Width="160" Text="{Binding Config.Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="导入模板" Margin="8,0,0,0" Click="LoadTemplate_Click"/>
                    <Button Content="导出模板" Margin="4,0,0,0" Click="SaveTemplate_Click"/>
                    <Button Content="刷新" Margin="4,0,0,0" Click="RefreshTemplate_Click"/>
                </StackPanel>

                <!-- 中间：运行配置参数 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                    <TextBlock Text="测试点数：" />
                    <TextBox Width="50" Text="{Binding Config.TestCount, UpdateSourceTrigger=PropertyChanged}"/>
                    
                    <TextBlock Text="时间限制(ms)：" Margin="12,0,0,0"/>
                    <TextBox Width="65" Text="{Binding Config.TimeLimitMs, UpdateSourceTrigger=PropertyChanged}"/>
                    
                    <TextBlock Text="失败策略：" Margin="12,0,0,0"/>
                    <ComboBox x:Name="FailurePolicyBox" Width="80" Height="28" VerticalContentAlignment="Center" SelectionChanged="FailurePolicy_Changed">
                        <ComboBoxItem IsSelected="True">继续</ComboBoxItem>
                        <ComboBoxItem>停止</ComboBoxItem>
                    </ComboBox>
                    
                    <TextBlock Text="重试次数：" Margin="12,0,0,0"/>
                    <TextBox x:Name="RetryBox" Width="40" Text="0" TextChanged="Retry_Changed"/>
                </StackPanel>

                <!-- 右侧：主要操作动作 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="生成并打包" Style="{StaticResource PrimaryButton}" Width="110" Height="30" Click="Generate_Click"/>
                    <Button Content="中止" Width="65" Height="30" Margin="6,0,0,0" Command="{Binding CancelCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. 核心工作区 (三栏布局) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 左栏：环境与路径配置 -->
                <ColumnDefinition Width="300"/>
                <!-- 中栏：字段设计器 -->
                <ColumnDefinition Width="380"/>
                <!-- 右栏：子任务矩阵 & 监控日志 (自适应拉伸) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= 第一栏：环境与存储配置 ================= -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="环境与存储配置" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="C++ 源文件 (.cpp)"/>
                            <DockPanel Margin="0,4,0,8">
                                <Button DockPanel.Dock="Right" Content="浏览" Width="46" Click="BrowseSource_Click"/>
                                <TextBox Text="{Binding Config.SourcePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"/>
                            </DockPanel>

                            <TextBlock Text="g++.exe 编译器路径"/>
                            <DockPanel Margin="0,4,0,8">
                                <Button DockPanel.Dock="Right" Content="浏览" Width="46" Click="BrowseGpp_Click"/>
                                <TextBox Text="{Binding Config.MingwPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"/>
                            </DockPanel>

                            <TextBlock Text="编译参数"/>
                            <TextBox Text="{Binding Config.CompileArgs, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>

                            <TextBlock Text="数据存储目录"/>
                            <DockPanel Margin="0,4,0,8">
                                <Button DockPanel.Dock="Right" Content="设置" Width="46" Click="BrowseStorage_Click"/>
                                <TextBox Text="{Binding Config.StorageDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"/>
                            </DockPanel>

                            <TextBlock Text="ZIP 输出路径"/>
                            <DockPanel Margin="0,4,0,12">
                                <Button DockPanel.Dock="Right" Content="浏览" Width="46" Click="BrowseZip_Click"/>
                                <TextBox Text="{Binding Config.ZipPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"/>
                            </DockPanel>

                            <Separator Background="{StaticResource BorderColor}" Margin="0,4,0,8"/>

                            <TextBlock Text="模板文件列表" FontWeight="SemiBold"/>
                            <ListBox x:Name="TemplateList" Height="100" Margin="0,6,0,6" MouseDoubleClick="TemplateList_DoubleClick"/>
                            <UniformGrid Columns="3">
                                <Button Content="删除" Click="DeleteTemplate_Click" Margin="0,0,2,0"/>
                                <Button Content="复制" Click="CopyTemplate_Click" Margin="2,0,2,0"/>
                                <Button Content="重命名" Click="RenameTemplate_Click" Margin="2,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ================= 第二栏：字段构建与属性编辑 ================= -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 标题 -->
                        <RowDefinition Height="Auto"/> <!-- 添加字段工具栏 -->
                        <RowDefinition Height="130"/>  <!-- 字段列表 -->
                        <RowDefinition Height="*"/>    <!-- 属性编辑面板 -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="数据字段定义" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>

                    <!-- 字段类型工具栏 -->
                    <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                        <Button Content="+ 整数" Margin="0,2,4,2" Click="AddInt_Click"/>
                        <Button Content="+ 浮点" Margin="0,2,4,2" Click="AddFloat_Click"/>
                        <Button Content="+ 字符" Margin="0,2,4,2" Click="AddString_Click"/>
                        <Button Content="+ 数组" Margin="0,2,4,2" Click="AddArray_Click"/>
                        <Button Content="+ 树" Margin="0,2,4,2" Click="AddTree_Click"/>
                        <Button Content="+ 图" Margin="0,2,4,2" Click="AddGraph_Click"/>
                        <Button Content="复制" Margin="6,2,4,2" Click="Copy_Click"/>
                        <Button Content="删除" Margin="0,2,0,2" Click="Delete_Click"/>
                    </WrapPanel>

                    <!-- 字段列表 -->
                    <ListBox x:Name="FieldList" Grid.Row="2" 
                             ItemsSource="{Binding Config.Fields}" 
                             DisplayMemberPath="Name" 
                             SelectionChanged="FieldList_SelectionChanged" 
                             AllowDrop="True" 
                             PreviewMouseLeftButtonDown="FieldList_MouseDown" 
                             PreviewMouseMove="FieldList_MouseMove" 
                             Drop="FieldList_Drop"
                             BorderBrush="{StaticResource BorderColor}"/>

                    <!-- 字段动态属性设置 -->
                    <GroupBox Grid.Row="3" Header="字段属性详细设置" Margin="0,8,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="EditorPanel" Margin="4"/>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </Border>

            <!-- ================= 第三栏：子任务覆盖矩阵 & 运行监控 (Tab 分离) ================= -->
            <TabControl Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}">
                
                <!-- TAB 1: 运行监控与状态 (日常高频使用) -->
                <TabItem Header="运行监控与测试点">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/> <!-- 测试点表格 -->
                            <RowDefinition Height="2*"/> <!-- 日志面板 -->
                        </Grid.RowDefinitions>

                        <!-- 测试点状态表 -->
                        <GroupBox Grid.Row="0" Header="测试点执行详情" Margin="0,0,0,6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="💡 双击左半区打开 .in 输入文件，双击右半区打开 .out 输出文件" Foreground="Gray" Margin="4,2,4,6"/>
                                <ListView x:Name="TestPointList" ItemsSource="{Binding TestPoints}" 
                                          MouseDoubleClick="TestPointList_DoubleClick" 
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Height" Value="26"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="编号" Width="50">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Index}" TextAlignment="Center"/></DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="状态" Width="85">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding StatusText}" TextAlignment="Center" FontWeight="SemiBold"/></DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="耗时" Width="100">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding DurationMs, StringFormat={}{0:F2} ms}" TextAlignment="Center"/></DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="信息 / 错误" Width="200">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Error}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="45">
                                                <GridViewColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Button Content="×" Width="22" Height="22" Padding="0" Click="CloseStatus_Click"/>
                                                    </DataTemplate>
                                                </GridViewColumn.HeaderTemplate>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text=""/></DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </GroupBox>

                        <!-- 日志窗口 -->
                        <GroupBox Grid.Row="1" Header="控制台日志">
                            <ListBox ItemsSource="{Binding Messages}" FontFamily="Consolas, 微软雅黑" FontSize="11" Margin="2"/>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <!-- TAB 2: 子任务与字段覆盖矩阵 (获得完全展开的大宽屏展示) -->
                <TabItem Header="子任务与覆盖矩阵 (Subtask)">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- 子任务划分控制 -->
                            <RowDefinition Height="*"/>    <!-- 覆盖矩阵表格 (充分展开) -->
                        </Grid.RowDefinitions>

                        <!-- 分组控制条 -->
                        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Subtask 数量："/>
                                    <TextBox x:Name="SubtaskCountBox" Width="40" Text="0"/>
                                    <Button Content="应用" Click="ApplySubtaskCount_Click" Margin="4,0,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                                    <TextBlock Text="测试点分组："/>
                                    <TextBox x:Name="GroupFromBox" Width="38" Text="1" LostFocus="GroupRange_Changed"/>
                                    <TextBlock Text=" ~ " Margin="2,0"/>
                                    <TextBox x:Name="GroupToBox" Width="38" Text="5" LostFocus="GroupRange_Changed"/>
                                    <Button Content="添加分组" Click="AddGroup_Click" Margin="6,0,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Button Content="删除选中分组" Click="DeleteGroup_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 下半部分：分组列表与矩阵 -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock DockPanel.Dock="Top" Text="分组列表" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ListBox x:Name="GroupList" SelectionChanged="GroupList_SelectionChanged"/>
                            </DockPanel>

                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Top" Text="子任务字段覆盖矩阵（双击单元格直接编辑覆盖值）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <DataGrid x:Name="OverrideMatrix" 
                                          AutoGenerateColumns="True" 
                                          CanUserAddRows="False" 
                                          IsReadOnly="True" 
                                          GridLinesVisibility="All"
                                          HorizontalGridLinesBrush="#E5E7EB"
                                          VerticalGridLinesBrush="#E5E7EB"
                                          CellEditEnding="OverrideMatrix_CellEditEnding" 
                                          MouseDoubleClick="OverrideMatrix_DoubleClick"/>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</Window>