<Window x:Class="DataMaker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DataMaker · OI 测试数据生成器" Width="1320" Height="820" Background="#F6F8FC"><DockPanel><Menu DockPanel.Dock="Top"><MenuItem Header="文件"><MenuItem Header="新建" Click="New_Click"/><MenuItem Header="打开配置" Click="Open_Click"/><MenuItem Header="保存配置" Click="Save_Click"/></MenuItem><MenuItem Header="模板"><MenuItem Header="序列 + 询问" Click="Template_Click"/></MenuItem><MenuItem Header="帮助"><MenuItem Header="关于 DataMaker"/></MenuItem></Menu><Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,10,0"><DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button Content="＋ 添加字段" Height="38" Click="Add_Click"/><Button Content="删除当前字段" Height="32" Margin="0,6,0,0" Click="Delete_Click"/></StackPanel><TextBlock DockPanel.Dock="Top" Text="字段列表" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><ListBox x:Name="Fields" DisplayMemberPath="Name" SelectionChanged="Field_Selected" AllowDrop="True" PreviewMouseLeftButtonDown="Fields_MouseDown" MouseMove="Fields_MouseMove" Drop="Fields_Drop"/></DockPanel></Border><Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,10,0"><ScrollViewer><StackPanel><TextBlock Text="字段配置" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="名称" Margin="0,20,0,4"/><TextBox x:Name="NameBox" Height="30" TextChanged="Config_Changed"/><TextBlock Text="类型" Margin="0,12,0,4"/><ComboBox x:Name="TypeBox" Height="30" SelectionChanged="Config_Changed"><ComboBoxItem>整数</ComboBoxItem><ComboBoxItem>浮点数</ComboBoxItem><ComboBoxItem>字符串</ComboBoxItem><ComboBoxItem>数组</ComboBoxItem><ComboBoxItem>树</ComboBoxItem><ComboBoxItem>图</ComboBoxItem></ComboBox><TextBlock Text="最小值 / 范围" Margin="0,12,0,4"/><TextBox x:Name="MinBox" Height="30" TextChanged="Config_Changed"/><TextBlock Text="最大值 / 长度" Margin="0,12,0,4"/><TextBox x:Name="MaxBox" Height="30" TextChanged="Config_Changed"/><TextBlock Text="数组元素类型" Margin="0,10,0,4"/><ComboBox x:Name="ElementTypeBox" Height="30" SelectionChanged="Config_Changed"><ComboBoxItem>整数</ComboBoxItem><ComboBoxItem>浮点数</ComboBoxItem><ComboBoxItem>字符串</ComboBoxItem></ComboBox><TextBlock Text="输出方式" Margin="0,12,0,4"/><ComboBox x:Name="OutputBox" Height="30"><ComboBoxItem>单独一行</ComboBoxItem><ComboBoxItem>一行空格分隔</ComboBoxItem></ComboBox><TextBlock Text="浮点精度" Margin="0,12,0,4"/><TextBox x:Name="PrecisionBox" Text="2" Height="30" TextChanged="Config_Changed"/><TextBlock Text="字符串字符集" Margin="0,10,0,4"/><TextBox x:Name="CharsetBox" Text="abcdefghijklmnopqrstuvwxyz" Height="30" TextChanged="Config_Changed"/><TextBlock Text="字符串构造" Margin="0,10,0,4"/><ComboBox x:Name="StringPatternBox" Height="30" SelectionChanged="Config_Changed"><ComboBoxItem>随机</ComboBoxItem><ComboBoxItem>回文</ComboBoxItem><ComboBoxItem>周期</ComboBoxItem><ComboBoxItem>全相同</ComboBoxItem></ComboBox><CheckBox x:Name="UniqueBox" Content="数组元素去重" Margin="0,10,0,0" Checked="Config_Changed" Unchecked="Config_Changed"/><TextBlock Text="数组排序" Margin="0,10,0,4"/><ComboBox x:Name="SortBox" Height="30" SelectionChanged="Config_Changed"><ComboBoxItem>不排序</ComboBoxItem><ComboBoxItem>升序</ComboBoxItem><ComboBoxItem>降序</ComboBoxItem></ComboBox><TextBlock Text="结构形态" Margin="0,10,0,4"/><ComboBox x:Name="StructureBox" Height="30" SelectionChanged="Config_Changed"><ComboBoxItem>random</ComboBoxItem><ComboBoxItem>chain</ComboBoxItem><ComboBoxItem>star</ComboBoxItem><ComboBoxItem>binary</ComboBoxItem><ComboBoxItem>directed</ComboBoxItem><ComboBoxItem>dag</ComboBoxItem></ComboBox><CheckBox x:Name="WeightedBox" Content="树/图带边权" Margin="0,10,0,0" Checked="Config_Changed" Unchecked="Config_Changed"/><CheckBox x:Name="ConnectedBox" Content="图保证连通" Margin="0,6,0,0" Checked="Config_Changed" Unchecked="Config_Changed"/><CheckBox x:Name="DirectedBox" Content="有向图" Margin="0,6,0,0" Checked="Config_Changed" Unchecked="Config_Changed"/><CheckBox x:Name="BipartiteBox" Content="二分图" Margin="0,6,0,0" Checked="Config_Changed" Unchecked="Config_Changed"/><CheckBox x:Name="SelfLoopBox" Content="允许自环" Margin="0,6,0,0" Checked="Config_Changed" Unchecked="Config_Changed"/><CheckBox x:Name="MultiEdgeBox" Content="允许重边" Margin="0,6,0,0" Checked="Config_Changed" Unchecked="Config_Changed"/><Separator Margin="0,24"/><TextBlock Text="测试点状态" FontSize="16" FontWeight="SemiBold"/><ListBox x:Name="StatusList" Height="120" Margin="0,8"/><TextBlock Text="运行日志" FontSize="16" FontWeight="SemiBold"/><TextBox x:Name="Log" Height="180" Margin="0,10" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel></ScrollViewer></Border><Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="测试点与运行" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="测试点数量" Margin="0,20,0,4"/><TextBox x:Name="CountBox" Text="20" Height="30"/><CheckBox x:Name="GroupsBox" Content="启用多组数据（T）" Margin="0,14"/><TextBlock Text="T 组数范围（启用多组时）" Margin="0,4,0,4"/><DockPanel><TextBox x:Name="GroupCountMinBox" Text="1" Width="50"/><TextBlock Text=" - " VerticalAlignment="Center"/><TextBox x:Name="GroupCountMaxBox" Text="5" Width="50"/></DockPanel><TextBlock Text="测试点分组覆盖" Margin="0,8,0,4"/><DockPanel><TextBox x:Name="GroupFromBox" Text="1" Width="45"/><TextBlock Text=" - " VerticalAlignment="Center"/><TextBox x:Name="GroupToBox" Text="5" Width="45"/><Button Content="添加分组" Margin="6,0,0,0" Click="AddGroup_Click"/></DockPanel><TextBox x:Name="GroupOverrideBox" Text="n:min=1;max=10" Margin="0,5,0,0" Height="28" ToolTip="格式：字段名:min=1;max=10"/><ListBox x:Name="GroupsList" Height="70" DisplayMemberPath="Display" Margin="0,5,0,0"/><Button Content="删除选中分组" Height="26" Margin="0,4,0,0" Click="DeleteGroup_Click"/><TextBlock Text="C++ 源文件（必须为 .cpp）" Margin="0,12,0,4"/><DockPanel><TextBox x:Name="StandardBox" Height="30"/><Button Content="选择" Width="58" Margin="6,0,0,0" Click="BrowseCpp_Click"/></DockPanel><TextBlock Text="MinGW g++.exe" Margin="0,12,0,4"/><DockPanel><TextBox x:Name="MingwBox" Height="30"/><Button Content="选择" Width="58" Margin="6,0,0,0" Click="BrowseMingw_Click"/></DockPanel><TextBlock Text="编译参数" Margin="0,12,0,4"/><TextBox x:Name="ArgsBox" Text="-O2 -std=c++17" Height="30"/><TextBlock Text="时间限制（毫秒）" Margin="0,12,0,4"/><TextBox x:Name="TimeBox" Text="1000" Height="30"/><TextBlock Text="内存限制（MB）" Margin="0,12,0,4"/><TextBox x:Name="MemoryBox" Text="256" Height="30"/><TextBlock Text="ZIP 输出文件" Margin="0,12,0,4"/><DockPanel><TextBox x:Name="ZipBox" Text="data.zip" Height="30"/><Button Content="选择" Width="58" Margin="6,0,0,0" Click="BrowseZip_Click"/></DockPanel><StackPanel Orientation="Horizontal" Margin="0,24,0,0"><Button Content="生成测试数据并打包" Height="44" Width="190" Background="#2563EB" Foreground="White" FontWeight="SemiBold" Click="Generate_Click"/><Button Content="中止" Height="44" Width="70" Margin="8,0,0,0" Click="Cancel_Click"/></StackPanel><ProgressBar x:Name="Progress" Height="8" Margin="0,16,0,0"/></StackPanel></ScrollViewer></Border></Grid></DockPanel></Window>
